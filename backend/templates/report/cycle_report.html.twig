<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>AACCUP Compliance Monitoring Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; font-size: 11px; color: #111; }
        h1 { text-align: center; color: #1a3a6b; font-size: 14px; margin-bottom: 4px; }
        h2 { color: #1a3a6b; font-size: 12px; margin-top: 20px; margin-bottom: 6px; border-bottom: 1px solid #ccc; padding-bottom: 3px; }
        .header-info { margin-bottom: 18px; }
        .header-info p { margin: 3px 0; }
        .meta { font-size: 10px; color: #555; text-align: right; margin-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 20px; }
        th, td { border: 1px solid #aaa; padding: 6px 8px; vertical-align: top; }
        th { background-color: #1a3a6b; color: #fff; font-size: 10px; text-align: center; }
        td { font-size: 10px; }
        .area-heading { background-color: #ddeeff; font-weight: bold; font-size: 11px; }
        .type-badge { display: inline-block; font-size: 9px; padding: 1px 5px; border-radius: 3px; font-weight: bold; }
        .type-mandatory { background-color: #ffd6d6; color: #8b0000; }
        .type-enhancement { background-color: #d6f0d6; color: #005500; }
        .remarks-complied { color: #198754; font-weight: bold; }
        .remarks-partial  { color: #fd7e14; font-weight: bold; }
        .remarks-na       { color: #6c757d; font-weight: bold; }
        .remarks-blank    { color: #aaa; }
        .footer { margin-top: 30px; font-size: 9px; color: #888; text-align: center; }
    </style>
</head>
<body>
    <h1>AACCUP Program Accreditation Compliance Monitoring Report</h1>
    <div class="meta">Generated by {{ generatedBy.fullName }} on {{ generatedAt|date('Y-m-d H:i') }}</div>

    <div class="header-info">
        <p><strong>Program:</strong> {{ cycle.program.name }} ({{ cycle.program.code }})</p>
        <p><strong>College:</strong> {{ cycle.program.college.name }}</p>
        <p><strong>Accreditation Level:</strong> {{ cycle.program.accreditationLevel|default('N/A') }}</p>
        <p><strong>Academic Year:</strong> {{ cycle.academicYear }}</p>
        <p><strong>SAR Received:</strong> {{ cycle.sarReceivedDate|date('F j, Y') }}</p>
        <p><strong>Compliance Deadline:</strong> {{ cycle.complianceDeadline|date('F j, Y') }}</p>
        <p><strong>Status:</strong> {{ cycle.status|upper }}</p>
    </div>

    {% for assignment in cycle.areaAssignments %}
        <h2>Area {{ assignment.area.areaNumber }}: {{ assignment.area.name }}</h2>

        {% if assignment.sarRecommendations|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th style="width:5%">#</th>
                    <th style="width:40%">Recommendation / Requirement</th>
                    <th style="width:30%">Compliance / Documents</th>
                    <th style="width:15%">Remarks</th>
                </tr>
            </thead>
            <tbody>
                {% for rec in assignment.sarRecommendations %}
                <tr>
                    <td style="text-align:center">{{ loop.index }}</td>
                    <td>
                        <span class="type-badge {{ rec.type == 'mandatory' ? 'type-mandatory' : 'type-enhancement' }}">
                            {{ rec.type|upper }}
                        </span><br>
                        {{ rec.recommendationText }}
                    </td>
                    <td>{{ rec.complianceDocuments|default('')|nl2br }}</td>
                    <td style="text-align:center">
                        {% if rec.remarks == 'COMPLIED' %}
                            <span class="remarks-complied">COMPLIED</span>
                        {% elseif rec.remarks == 'PARTIAL' %}
                            <span class="remarks-partial">PARTIAL</span>
                        {% elseif rec.remarks == 'NA' %}
                            <span class="remarks-na">NA</span>
                        {% else %}
                            <span class="remarks-blank">&mdash;</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="color:#888; font-size:10px; margin-left:8px;">No SAR recommendations entered for this area.</p>
        {% endif %}

        {% if assignment.complianceActivities|length > 0 %}
        <p style="font-size:10px; margin-left:4px; margin-top:4px;"><em>Compliance Activities ({{ assignment.complianceActivities|length }}):</em>
            {% for act in assignment.complianceActivities %}
                {{ act.title }} [{{ act.state|upper }}]{% if not loop.last %}, {% endif %}
            {% endfor %}
        </p>
        {% endif %}

        <p style="font-size:10px; margin-left:4px;">
            <strong>IA Review Status:</strong>
            {% if assignment.iaStatus == 'approved' %}
                <span style="color:#198754; font-weight:bold;">APPROVED</span>
            {% elseif assignment.iaStatus == 'needs_revision' %}
                <span style="color:#dc3545; font-weight:bold;">NEEDS REVISION</span>
            {% else %}
                <span style="color:#888;">PENDING</span>
            {% endif %}
            {% if assignment.iaComments %} &mdash; {{ assignment.iaComments }}{% endif %}
        </p>
    {% endfor %}

    <div class="footer">
        NORSU &mdash; AACCUP Program Accreditation Monitoring System &mdash; {{ generatedAt|date('Y') }}
    </div>
</body>
</html>
