<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>AACCUP Monitoring Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        h1 { text-align: center; color: #1a5276; }
        .header-info { margin-bottom: 30px; border-bottom: 2px solid #ccc; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <h1>AACCUP Program Accreditation Monitoring Report</h1>
    
    <div class="header-info">
        <p><strong>Program:</strong> {{ cycle.program.name }} ({{ cycle.program.code }})</p>
        <p><strong>College:</strong> {{ cycle.program.college.name }}</p>
        <p><strong>Academic Year:</strong> {{ cycle.academicYear }}</p>
        <p><strong>Compliance Deadline:</strong> {{ cycle.complianceDeadline|date('F j, Y') }}</p>
        <p><strong>Status:</strong> {{ cycle.status|upper }}</p>
        <p><em>Generated by {{ generatedBy.fullName }} on {{ generatedAt|date('Y-m-d H:i') }}</em></p>
    </div>

    <h2>Area Assignments & IA Review Status</h2>
    <table>
        <thead>
            <tr>
                <th>Area</th>
                <th>Status</th>
                <th>IA Comments</th>
            </tr>
        </thead>
        <tbody>
        {% for assignment in cycle.areaAssignments %}
            <tr>
                <td>Area {{ assignment.area.areaNumber }}: {{ assignment.area.name }}</td>
                <td>{{ assignment.iaStatus|upper }}</td>
                <td>{{ assignment.iaComments|default('None') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>
